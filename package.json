{
  "name": "grade-stack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The open reference stack for getting mid-market AI agents to production: reliable, observable, governed.",
  "license": "Apache-2.0",
  "author": "Inbound Team, LLC dba Clarke Bishop Consulting (https://clarkebishop.com)",
  "workspaces": [
    "packages/*",
    "reference-agent"
  ],
  "scripts": {
    "reliability": "bun packages/cli/src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && bun run check:file-docs && bun run check:owasp-coverage && bun run check:nist-coverage && bun run check:eu-ai-act && bun run check:actions-pinned",
    "check:file-docs": "bun run scripts/check-file-docs.ts",
    "check:owasp-coverage": "bun run scripts/check-owasp-coverage.ts",
    "check:nist-coverage": "bun run scripts/check-nist-coverage.ts",
    "check:eu-ai-act": "bun run scripts/check-eu-ai-act.ts",
    "check:actions-pinned": "bun run scripts/check-actions-pinned.ts",
    "audit:runtime": "bun run scripts/check-dependency-audit.ts --audit-level=high",
    "build": "bun build packages/cli/src/index.ts --target bun --outdir dist",
    "test": "bun test",
    "label-judge": "bash scripts/label-judge.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xmldom/xmldom": "^0.9.12",
    "body-parser": "^2.4.0",
    "compression": "^1.8.2",
    "engine.io": "~6.6.11",
    "fast-uri": "^3.1.6",
    "follow-redirects": "^1.16.2",
    "hono": "^4.13.11",
    "ip-address": "^10.3.1",
    "mongoose": "^9.11.4",
    "node-forge": "^1.4.2",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.1",
    "socket.io-parser": "~4.2.7",
    "zod": "^4.6.7"
  }
}

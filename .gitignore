# Dependencies / build output
node_modules/
dist/
build/
*.tsbuildinfo

# Secrets — never commit; inject via env
.env
.env.*
!.env.example

# Internal strategy / positioning — NEVER publish (public repo)
docs/internal/

# Generated assessment artifacts (reproducible output of the Production-Readiness
# Assessment runbook — see docs/production-readiness-assessment.md). Never commit
# a local run's output; the committed samples live under content/cycle-03/.
/eval-results.json
/eval-results/
/scorecard.md
/scorecard.html

# OS / editor
.DS_Store
*.log

# Gateway decision log and opt-in content capture (Phase 4B). Runtime records of
# a local gateway; retention is the deployer's policy, never the repo's.
gateway-decisions.jsonl
gateway-captures/

# Kill-switch halt file (Phase 4C); written by `reliability gateway halt`
.reliability-halt

# Human review queue (Phase 4D); written by the gateway and `reliability review`.
# The committed sample lives in governance/drills/review-queue-<date>.jsonl.
review-queue.jsonl
review-queue.jsonl.lock

# Agent bearer tokens (Phase 4E): secrets, never committed. The default tokens
# file the gateway and MCP server read when RELIABILITY_AGENT_TOKENS_FILE is unset.
.reliability-agent-tokens
*.tokens
